# Local development settings. Copy this file and you are done:
#
#   cp .env.sample .env
#
# .env is git-ignored; .env.sample is the committed documentation of every
# variable the app reads. Values below match the containers defined in the
# repo root's docker-compose.yml.

# Postgres — host port 5433 maps to the container's 5432
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_USER=tinta
DATABASE_PASSWORD=tinta
DATABASE_NAME=tinta_development
TEST_DATABASE_NAME=tinta_test

# Redis — host port 6380 maps to the container's 6379
REDIS_URL=redis://127.0.0.1:6380/0
